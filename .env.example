# copy this to .env and put your actual db url here
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# gemini api key for the ai features (https://aistudio.google.com/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# production frontend origin for CORS (defaults to http://localhost:5173 in dev)
FRONTEND_URL="http://localhost:5173"
